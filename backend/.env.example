DATABASE_URL="postgresql://user:password@localhost:5432/lia"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Origem (frontend) permitida no CORS.
# Em desenvolvimento pode ficar vazio (libera qualquer origem).
# Ex.: FRONTEND_URL="http://localhost:5173" ou "https://app.lia.app"
FRONTEND_URL=

# WhatsApp Cloud API — notificações automáticas (opcional para o MVP)
# Mantenha WHATSAPP_ENABLED=false para NÃO chamar a API externa.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
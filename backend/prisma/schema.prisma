generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id   String   @id @default(cuid())
  role UserRole @default(WORKER)

  name String

  email String @unique

  password String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  opportunities    Opportunity[]
  workerProfile    WorkerProfile?
  recruiterProfile RecruiterProfile?
  applications     Application[]
  enrollments      CourseEnrollment[]
  certificates     Certificate[]

  @@index([email])
}

enum UserRole {
  WORKER
  RECRUITER
}

enum OpportunityType {
  JOB
  SERVICE
}

enum OpportunityStatus {
  ACTIVE
  CLOSED
}

enum OpportunitySource {
  LIA
  EXTERNAL
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CourseSource {
  LIA
  EXTERNAL
}

enum CourseEnrollmentStatus {
  IN_PROGRESS
  COMPLETED
}

model Opportunity {
  id          String            @id @default(cuid())
  title       String
  description String
  type        OpportunityType
  location    String?
  status      OpportunityStatus @default(ACTIVE)
  category    String?
  tags        String[]
  source      OpportunitySource @default(LIA)
  externalUrl String?
  sourceName  String?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
}

model WorkerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsapp     String?
  city         String?
  neighborhood String?
  bio          String?
  skills       String[]
  interests    String[]

  professionalTitle        String?
  availability             String?
  desiredRoles             String[]
  workPreferences          String[]
  discoverableByRecruiters Boolean  @default(false)
  whatsappOptIn            Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecruiterProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String
  whatsapp         String?
  city             String?
  neighborhood     String?
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id            String            @id @default(cuid())
  opportunityId String
  workerId      String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  worker        User              @relation(fields: [workerId], references: [id], onDelete: Cascade)

  status ApplicationStatus @default(APPLIED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, workerId])
  @@index([workerId])
  @@index([opportunityId, status])
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  category    String?
  skills      String[]
  provider    String?
  externalUrl String?
  source      CourseSource @default(LIA)

  lessons     Lesson[]
  enrollments CourseEnrollment[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, createdAt])
}

model Lesson {
  id         String @id @default(cuid())
  courseId   String
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String
  orderIndex Int

  @@unique([courseId, orderIndex])
}

model CourseEnrollment {
  id        String                @id @default(cuid())
  courseId  String
  workerId  String
  course    Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  worker    User                  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  completedLessonIds String[]
  status             CourseEnrollmentStatus @default(IN_PROGRESS)
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, workerId])
  @@index([workerId])
}

model Certificate {
  id        String   @id @default(cuid())
  code      String   @unique
  courseId  String
  workerId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  worker    User     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  issuedAt DateTime @default(now())

  @@unique([courseId, workerId])
  @@index([workerId])
}
